rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Hostel listings — deliberately world-readable (to any signed-in
    // student) with every field included, since nothing about a listing is
    // meant to be gated behind a code. Only the owner can create, edit, or
    // delete their own listing. The one exception is viewCount: any student
    // opening the detail view increments it (see discover.js), so a second
    // clause allows that single-field update from anyone signed in, without
    // opening the rest of the document to edits from non-owners.
    match /hostels/{hostelId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
      );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    match /threads/{threadId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create, update: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
    }
    match /threads/{threadId}/messages/{messageId} {
      allow read: if request.auth != null && threadId.matches('.*' + request.auth.uid + '.*');
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false; // reports are write-only from the client; review them in the console
    }

    // Discover's quick-feedback chips on a hostel's detail view. Anyone
    // signed in can leave one, but only as themselves — same create-only
    // shape as reports. Unlike reports, read access is open to any signed-in
    // student (not just the owner): feedback is meant as public, lightweight
    // social proof on the listing itself, plus it powers the owner's live
    // notification listener (notifications.js) and the summary on their own
    // My Listings page (profile.js).
    match /feedback/{feedbackId} {
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if false; // immutable once sent, same as reports
    }
  }
}
